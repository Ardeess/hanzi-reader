{
  "manifest_version": 3,
  "name": "Hanzi Reader",
  "version": "1.3.0",
  "description": "Для изучающих китайский: читалка PDF и субтитры YouTube с пиньинем. Выделите слово — пиньин и перевод, выделите фразу — полный перевод.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Открыть Hanzi PDF Reader"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "yt-loader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "youtube.js",
        "popup-core.js",
        "backend.js",
        "dict.js",
        "translator.js",
        "popup.css",
        "yt.css"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}